# Copy to .env.local and supply your existing Turso database credentials.
# These are database credentials, not the Turso Platform API token.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-database-token

# Optional live organization usage (separate Platform API credentials).
# Uncomment and replace both values to enable Refresh live usage.
# TURSO_ORGANIZATION=your-organization-slug
# TURSO_API_TOKEN=your-platform-api-token
